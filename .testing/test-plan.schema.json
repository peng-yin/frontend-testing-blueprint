{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peng-yin/frontend-testing-blueprint/.testing/test-plan.schema.json",
  "title": "AI test completion plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "change_id", "summary", "behaviors"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "change_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "behaviors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "risk",
          "source",
          "required_tests",
          "evidence",
          "commands"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "risk": {
            "enum": ["low", "medium", "high", "critical"]
          },
          "source": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_tests": {
            "type": "object",
            "additionalProperties": false,
            "required": ["unit", "storybook", "mutation", "e2e"],
            "properties": {
              "unit": {
                "type": "boolean"
              },
              "storybook": {
                "type": "boolean"
              },
              "mutation": {
                "type": "boolean"
              },
              "e2e": {
                "type": "boolean"
              }
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["unit", "storybook", "mutation", "e2e"],
            "properties": {
              "unit": {
                "$ref": "#/$defs/pathList"
              },
              "storybook": {
                "$ref": "#/$defs/pathList"
              },
              "mutation": {
                "$ref": "#/$defs/pathList"
              },
              "e2e": {
                "$ref": "#/$defs/pathList"
              }
            }
          },
          "commands": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "pathList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
